model TrackingEvent {
  id          String         @id @default(uuid())
  shipmentId  String
  status      ShipmentStatus
  note        String?
  location    String?
  updatedById String?
  createdAt   DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
  @@map("tracking_events")
}