model Notification {
  id         String   @id @default(uuid())
  userId     String
  title      String
  message    String
  shipmentId String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}