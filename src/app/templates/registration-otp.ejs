<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Verify Your Email</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f8;font-family:Arial,Helvetica,sans-serif;">
	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f8;padding:24px 0;">
		<tr>
			<td align="center">
				<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background-color:#ffffff;border-radius:8px;overflow:hidden;">
					<!-- Header -->
					<tr>
						<td align="center" style="background-color:#1e40af;padding:24px;">
							<h1 style="margin:0;color:#ffffff;font-size:22px;">Courier &amp; Logistics</h1>
						</td>
					</tr>

					<!-- Body -->
					<tr>
						<td style="padding:32px 32px 16px 32px;color:#1f2937;font-size:15px;line-height:24px;">
							<p style="margin:0 0 16px 0;">Hi <strong><%= name %></strong>,</p>
							<p style="margin:0 0 8px 0;">
								Welcome aboard! Please verify your email address <strong><%= email %></strong> to finish creating your account.
							</p>
							<p style="margin:0 0 24px 0;">Enter the one-time code below:</p>

							<!-- OTP -->
							<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
								<tr>
									<td align="center" style="padding:16px;background-color:#eff6ff;border:1px dashed #1e40af;border-radius:8px;">
										<span style="font-size:32px;font-weight:bold;letter-spacing:8px;color:#1e40af;"><%= otpValue %></span>
									</td>
								</tr>
							</table>

							<p style="margin:24px 0 0 0;">
								This code expires in <strong><%= expirationMinutes %> minutes</strong>.
							</p>
						</td>
					</tr>

					<!-- Security note -->
					<tr>
						<td style="padding:0 32px 32px 32px;color:#6b7280;font-size:13px;line-height:20px;">
							<p style="margin:0;">
								If you didn't create an account with us, you can safely ignore this email. Never share this code with anyone, including our support team.
							</p>
						</td>
					</tr>

					<!-- Footer -->
					<tr>
						<td align="center" style="background-color:#f9fafb;padding:16px;color:#9ca3af;font-size:12px;">
							&copy; <%= new Date().getFullYear() %> Courier &amp; Logistics Management. All rights reserved.
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
</body>
</html>