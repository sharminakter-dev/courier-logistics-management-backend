<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Password Reset Successful</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f8;font-family:Arial,Helvetica,sans-serif;">
	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f8;padding:24px 0;">
		<tr>
			<td align="center">
				<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background-color:#ffffff;border-radius:8px;overflow:hidden;">
					<!-- Header -->
					<tr>
						<td align="center" style="background-color:#15803d;padding:24px;">
							<h1 style="margin:0;color:#ffffff;font-size:22px;">Courier &amp; Logistics</h1>
						</td>
					</tr>

					<!-- Body -->
					<tr>
						<td align="center" style="padding:32px 32px 16px 32px;color:#1f2937;font-size:15px;line-height:24px;">
							<div style="width:56px;height:56px;line-height:56px;border-radius:50%;background-color:#dcfce7;color:#15803d;font-size:30px;font-weight:bold;margin:0 auto 16px auto;">&#10003;</div>
							<h2 style="margin:0 0 16px 0;font-size:20px;color:#15803d;">Password Reset Successful</h2>
							<p style="margin:0 0 16px 0;text-align:left;">Hi <strong><%= name %></strong>,</p>
							<p style="margin:0;text-align:left;">
								Your password has been changed successfully. You can now log in with your new password.
							</p>
						</td>
					</tr>

					<!-- Security note -->
					<tr>
						<td style="padding:16px 32px 32px 32px;color:#6b7280;font-size:13px;line-height:20px;">
							<p style="margin:0;">
								If you didn't make this change, please contact our support team immediately so we can secure your account.
							</p>
						</td>
					</tr>

					<!-- Footer -->
					<tr>
						<td align="center" style="background-color:#f9fafb;padding:16px;color:#9ca3af;font-size:12px;">
							&copy; <%= new Date().getFullYear() %> Courier &amp; Logistics Management. All rights reserved.
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
</body>
</html>